#!/bin/sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# 1) 문서 sync drift 경고 (짝꿍 한쪽만 staged 시)
if [ -x "$repo_root/.githooks/sync-warn.sh" ]; then
  "$repo_root/.githooks/sync-warn.sh"
fi

# 2) npm lint/build/test (package.json 있을 때만)
if [ ! -f package.json ]; then
  echo "pre-commit: package.json not found; skipping npm lint/build/test."
  exit 0
fi

run() {
  echo "pre-commit: running $*"
  "$@"
}

run npm run lint
run npm run build
run npm run test
