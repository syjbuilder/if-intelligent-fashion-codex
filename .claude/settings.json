{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Edit|Write|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "$root = git rev-parse --show-toplevel; & \"C:\\Program Files\\Git\\bin\\bash.exe\" (Join-Path $root \".claude/hooks/tdd-guard.sh\")",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
