# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Environment
.env
.env.*
!.env.example

# Node / Next.js
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python / tooling
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Local generated files
*.tmp
*.bak

# Media (large files / not appropriate for git)
*.mp4
*.mov
*.webm
*.avi
*.mkv

# Reference docs (large) — 기존에 추적 중인 PDF는 그대로 두고, 새로 들어오는 PDF만 차단
*.pdf

# Specific large assets
기획/서비스 개발 전체 과정.png

# 레퍼런스 mp4에서 추출한 프레임/분석 결과물 (원본 mp4가 gitignore되므로 산출물도 제외)
디자인/레퍼런스/_analysis_*/

# 개인 학습·외부 참고 자산 — git 추적하지 않음 (docs/DOC_MAP.md "제외" 섹션 참조)
학습/

# Per-user Claude settings (개인별 권한·실행 모드)
.claude/settings.local.json

# 하위 프로젝트의 .claude/skills/ 는 cross-platform에서 깨진 심볼릭 링크라 무시한다.
# 단, 루트 harness 스킬(.claude/skills/)은 추적한다.
**/.claude/skills/
!/.claude/skills/

# Harness phase 실행 산출물
phases/**/phase*-output.json
phases/**/step*-output.json
