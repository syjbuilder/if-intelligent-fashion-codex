# I.F 환경 변수 예시 — 실제 값은 .env.local에 넣고 절대 커밋하지 않는다 (CLAUDE.md CRITICAL).
# 자세한 설명: docs/ARCHITECTURE.md §환경/마이그레이션 절차

# Supabase (public — RLS로 보호)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (secret — 서버 영역 전용, ADR-016)
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (secret — Phase 5 이미지 생성 진입 게이트에서 발급)
OPENAI_API_KEY=

# AI 비용 안전장치 (ADR-015) — env로 관리 (app_config 테이블 아님)
DAILY_GENERATION_CAP=600
GENERATION_KILL_SWITCH=off
